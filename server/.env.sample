EMAIL_USER=nepasrepondre@wegather.fr
EMAIL_PASS=YOUR_EMAIL_PASSWORD

TOKEN_SECRET=YOUR_TOKEN_SECRET

# Webhook du salon Discord qui reçoit le formulaire de contact
# (Paramètres du salon > Intégrations > Webhooks > Copier l'URL du webhook)
DISCORD_CONTACT_WEBHOOK_URL=YOUR_DISCORD_WEBHOOK_URL