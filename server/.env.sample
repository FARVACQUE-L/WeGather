APP_PORT=3310

# development : affiche le détail des erreurs 500 (à ne pas définir en production)
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_NAME=wegather

CLIENT_URL=http://localhost:3000

EMAIL_USER=YOUR_EMAIL_USER
EMAIL_PASS=YOUR_EMAIL_PASSWORD

TOKEN_SECRET=YOUR_TOKEN_SECRET

# Webhook du salon Discord qui reçoit le formulaire de contact
# (Paramètres du salon > Intégrations > Webhooks > Copier l'URL du webhook)
DISCORD_CONTACT_WEBHOOK_URL=YOUR_DISCORD_WEBHOOK_URL